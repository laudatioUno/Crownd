{
    "name": "crownd/crownd",
    "description": "Crownd - self-hosted fan voting for the player of the match: one MVP per team, voting on the phone, results at a glance.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/laudatioUno/Crownd",
    "require": {
        "php": ">=8.3",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "chillerlan/php-qrcode": "^6.0",
        "twig/twig": "^3.29"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Crownd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crownd\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
