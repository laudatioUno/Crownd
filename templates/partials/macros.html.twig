{# Shared helpers. errors holds translation keys per field. #}

{% macro crown(class = 'crown') %}
  <svg class="{{ class }}" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6 22l13 11 13-21 13 21 13-11-5 28H11z"/><path fill="currentColor" d="M11 53h42v5H11z"/><circle fill="currentColor" cx="6" cy="20" r="4"/><circle fill="currentColor" cx="32" cy="9" r="4"/><circle fill="currentColor" cx="58" cy="20" r="4"/></svg>
{% endmacro %}

{% macro avatar(player, size = '', team_id = null) %}
  <span class="avatar{{ size ? ' avatar--' ~ size }}{{ team_id ? ' team-' ~ team_id }}">
    {%- if player.photo_file %}<img src="{{ media(player.photo_file) }}" alt="" loading="lazy">{% else %}<span aria-hidden="true">{{ player.name|initials }}</span>{% endif -%}
  </span>
{% endmacro %}

{% macro team_logo(logo, name, team_id, size = '') %}
  {%- if logo -%}
    <img src="{{ media(logo) }}" alt="" class="logo{{ size ? ' logo--' ~ size }}">
  {%- else -%}
    <span class="logo-ph{{ size ? ' logo-ph--' ~ size }} team-{{ team_id }}" aria-hidden="true">{{ name|initials }}</span>
  {%- endif -%}
{% endmacro %}

{% macro field(name, label, value, errors, type = 'text', opts = {}) %}
  {% set error = errors[name] ?? null %}
  {% set fid = opts.id ?? ('f-' ~ name) %}
  <div class="field{{ error ? ' field--error' }}">
    <label for="{{ fid }}">{{ label }}{% if opts.optional ?? false %} <span class="muted">{{ t('app.optional') }}</span>{% endif %}</label>
    <input id="{{ fid }}" name="{{ name }}" type="{{ type }}"
      {%- if type != 'password' and type != 'file' %} value="{{ value }}"{% endif %}
      {%- if opts.autocomplete is defined %} autocomplete="{{ opts.autocomplete }}"{% endif %}
      {%- if opts.required ?? false %} required{% endif %}
      {%- if opts.autofocus ?? false %} autofocus{% endif %}
      {%- if opts.inputmode is defined %} inputmode="{{ opts.inputmode }}"{% endif %}
      {%- if opts.placeholder is defined %} placeholder="{{ opts.placeholder }}"{% endif %}
      {%- if opts.maxlength is defined %} maxlength="{{ opts.maxlength }}"{% endif %}
      {%- if opts.min is defined %} min="{{ opts.min }}"{% endif %}
      {%- if opts.max is defined %} max="{{ opts.max }}"{% endif %}
      {%- if opts.accept is defined %} accept="{{ opts.accept }}"{% endif %}
      {%- if opts.list is defined %} list="{{ opts.list }}"{% endif %}
      {%- if error or opts.help is defined %} aria-describedby="{{ error ? 'e-' ~ fid : 'h-' ~ fid }}"{% endif %}
      {%- if error %} aria-invalid="true"{% endif %}>
    {% if error %}<p class="field__error" id="e-{{ fid }}">{{ t(error) }}</p>
    {% elseif opts.help is defined %}<p class="field__help" id="h-{{ fid }}">{{ opts.help }}</p>{% endif %}
  </div>
{% endmacro %}

{% macro textarea(name, label, value, errors, opts = {}) %}
  {% set error = errors[name] ?? null %}
  {% set fid = opts.id ?? ('f-' ~ name) %}
  <div class="field{{ error ? ' field--error' }}">
    <label for="{{ fid }}">{{ label }}{% if opts.optional ?? false %} <span class="muted">{{ t('app.optional') }}</span>{% endif %}</label>
    <textarea id="{{ fid }}" name="{{ name }}" rows="{{ opts.rows ?? 3 }}"
      {%- if opts.maxlength is defined %} maxlength="{{ opts.maxlength }}"{% endif %}
      {%- if opts.placeholder is defined %} placeholder="{{ opts.placeholder }}"{% endif %}
      {%- if error or opts.help is defined %} aria-describedby="{{ error ? 'e-' ~ fid : 'h-' ~ fid }}"{% endif %}
      {%- if error %} aria-invalid="true"{% endif %}>{{ value }}</textarea>
    {% if error %}<p class="field__error" id="e-{{ fid }}">{{ t(error) }}</p>
    {% elseif opts.help is defined %}<p class="field__help" id="h-{{ fid }}">{{ opts.help }}</p>{% endif %}
  </div>
{% endmacro %}

{% macro flashes(flashes) %}
  {% for f in flashes %}
    <div class="notice notice--{{ f.type }}" role="{{ f.type == 'error' ? 'alert' : 'status' }}">{{ f.message }}</div>
  {% endfor %}
{% endmacro %}

{% macro form_error(errors) %}
  {% if errors._form is defined %}
    <div class="notice notice--error" role="alert">{{ t(errors._form) }}</div>
  {% endif %}
{% endmacro %}

{% macro nav_link(path, label, current_path) %}
  {% set active = current_path == path or (path != '/admin' and current_path starts with path ~ '/') %}
  <a href="{{ url(path) }}" class="topbar__link{{ active ? ' is-active' }}"{% if active %} aria-current="page"{% endif %}>{{ label }}</a>
{% endmacro %}

{% macro status_badge(status) %}
  <span class="badge badge--{{ status }}">{{ t('matches.status.' ~ status) }}</span>
{% endmacro %}

{% macro matchup_names(match) %}
  {{ match.home_name }} <span class="muted">{{ t('app.vs') }}</span> {{ match.away_name }}
{% endmacro %}

{% macro match_meta(match) %}
  {%- set parts = [] -%}
  {%- if match.competition %}{% set parts = parts|merge([match.competition]) %}{% endif -%}
  {%- if match.kickoff_at %}{% set parts = parts|merge([match.kickoff_at|kickoff]) %}{% endif -%}
  {%- if match.venue %}{% set parts = parts|merge([match.venue]) %}{% endif -%}
  {{- parts|join(' · ') -}}
{% endmacro %}

{% macro ballots(count) %}
  {{- count == 1 ? t('matches.ballots_one') : t('matches.ballots', {count: count}) -}}
{% endmacro %}
